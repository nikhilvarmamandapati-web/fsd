import { createRoot } from 'react-dom/client';  
const name = 'Student'; const subjects = ['ExpressJS', 'ReactJS', 'MongoDB'];
const isEnrolled = true;   const container = (   <div>  
<h1>Welcome, {name}!</h1>  
<p>Today is {new Date().toDateString()}</p> 
<ul>       {subjects.map((subject, index) => (     
<li key={index}>{subject}</li>       ))} 
</ul>    
{isEnrolled ? <p>Status: Enrolled</p> : <p>Status: Not enrolled</p>}   </div> ); 
const root = createRoot(document.getElementById('root'));
root.render(container); 
