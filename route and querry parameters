const express = require("express");

const app = express();
const PORT = 3000;

// 1. Define a basic route
app.get("/", (req, res) => {
    res.send("Welcome to the Express.js Application");
});

// 2. Handling Routes
app.get("/about", (req, res) => {
    res.send("This is the About Page");
});

app.get("/contact", (req, res) => {
    res.send("This is the Contact Page");
});

// 3. Route Parameters
// Example: /user/101
app.get("/user/:id", (req, res) => {
    const userId = req.params.id;
    res.send(`User ID is: ${userId}`);
});

// Multiple route parameters
// Example: /student/101/Raghavendra
app.get("/student/:id/:name", (req, res) => {
    const id = req.params.id;
    const name = req.params.name;

    res.send(`Student ID: ${id}, Name: ${name}`);
});

// 4. Query Parameters
// Example: /search?name=Raghavendra&age=20
app.get("/search", (req, res) => {
    const name = req.query.name;
    const age = req.query.age;

    res.send(`Name: ${name}, Age: ${age}`);
});

// 5. URL Building
app.get("/profile", (req, res) => {
    const userId = 101;
    const userName = "Raghavendra";

    const profileURL = `/user/${userId}?name=${userName}`;

    res.send(`Profile URL: ${profileURL}`);
});

// Start the server
app.listen(PORT, () => {
    console.log(`Server running at http://localhost:${PORT}`);
});
